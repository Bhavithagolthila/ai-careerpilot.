# Copy this file to ".env" (same folder) and edit it. Never commit the real .env.
ENVIRONMENT=development
MONGODB_URI=mongodb://localhost:27017
DB_NAME=careerpilot
# Frontend address allowed by CORS. Several URLs can be separated by commas.
FRONTEND_ORIGIN=http://localhost:5173
# Make your own with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-this-to-a-long-random-string-of-32-or-more-characters
JWT_EXPIRE_MINUTES=60
# Login rate limit: failed attempts allowed per window (per IP + email)
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=900
# OPTIONAL. Leave empty to use free rule-based tips. If you add a key, skill NAMES (never resume text)
# are sent to the Anthropic API to write the tips, which may cost money on your account.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
